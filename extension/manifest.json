{
  "manifest_version": 3,
  "name": "Dynamic Backgrounds",
  "version": "1.13.18",
  "description": "Apply a Dynamic Backgrounds iframe, mosaic themes, and message themes to matching output URLs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dynamic Backgrounds",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.thefamousgroup.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.thefamousgroup.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.thefamousgroup.com/*"
      ],
      "js": [
        "rules.js",
        "handoff.js",
        "content.js",
        "mosaic-themes.js",
        "message-themes.js",
        "engines/api.js",
        "engines/example-aurora.js",
        "engines/example-orbit-swap.js",
        "custom-themes.js",
        "mosaic.js",
        "message.js",
        "vendor/three.min.js",
        "vendor/RoundedBoxGeometry.js",
        "vendor/tile-field.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
