{
  "manifest_version": 3,
  "name": "Dynamic Backgrounds",
  "version": "1.29.22",
  "minimum_chrome_version": "120",
  "description": "Apply a Dynamic Backgrounds iframe, mosaic themes, and message themes to matching output URLs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dynamic Backgrounds",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "userScripts",
    "tabs"
  ],
  "host_permissions": [
    "*://*.thefamousgroup.com/*",
    "*://*.vixisuite.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.thefamousgroup.com/*",
        "*://*.vixisuite.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.thefamousgroup.com/*",
        "*://*.vixisuite.com/*"
      ],
      "js": [
        "rules.js",
        "media.js",
        "handoff.js",
        "content.js",
        "mosaic-themes.js",
        "message-themes.js",
        "engines/api.js",
        "engines/xmas-snow-particles.js",
        "engines/message-aurora-engine.js",
        "engines/message-text-message-engine.js",
        "engines/mosaic-orbit-swap-engine.js",
        "engines/mosaic-xmas-wreath-engine.js",
        "engines/mosaic-xmas-tree-engine.js",
        "engines/mosaic-xmas-snowfall-engine.js",
        "engines/message-xmas-bauble-engine.js",
        "engines/mosaic-slant-rows-engine.js",
        "custom-themes.js",
        "leaderboard-themes.js",
        "mosaic.js",
        "message.js",
        "leaderboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "packs/*.json",
        "packs/assets/*"
      ],
      "matches": [
        "*://*.thefamousgroup.com/*",
        "*://*.vixisuite.com/*"
      ]
    }
  ]
}
