{"format":"dynamic-backgrounds-theme","version":1,"kind":"mosaic","id":"mosaic-xmas-snowfall","label":"Christmas Snowfall","layout":"scatter","count":8,"interval":2600,"css":"#dyn-mosaic-theme[data-theme=\"mosaic-xmas-snowfall\"]{background-color:#0b1a14;background-image:url(\"data:image/webp;base64,\"),url(\"data:image/webp;base64,\"),url(\"data:image/webp;base64,\");background-size:min(12%,130px),min(12%,130px),cover;background-position:2.5% 94%,97% 4%,center;background-repeat:no-repeat,no-repeat,no-repeat;container-type:size;}#dyn-mosaic-theme[data-theme=\"mosaic-xmas-snowfall\"] .dyn-card{position:absolute;width:min(16vw,230px);aspect-ratio:2/3;height:auto;transition:transform .95s cubic-bezier(.22,.8,.2,1);border-radius:14px;overflow:hidden;outline:3px solid rgba(255,255,255,.88);box-shadow:0 14px 36px rgba(0,0,0,.45),inset 0 0 0 1px rgba(190,230,255,.35);}#dyn-mosaic-theme.dyn-portrait[data-theme=\"mosaic-xmas-snowfall\"]{background-size:min(18%,120px),min(18%,120px),cover;background-position:3% 96%,96% 3%,center;}#dyn-mosaic-theme.dyn-portrait[data-theme=\"mosaic-xmas-snowfall\"] .dyn-card{width:min(38cqw,230px);}","engine":"mosaic-xmas-snowfall-engine","engineFile":"mosaic-xmas-snowfall-engine.js"}