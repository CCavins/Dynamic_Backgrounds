{
  "format": "dynamic-backgrounds-theme",
  "version": 1,
  "kind": "mosaic",
  "id": "mosaic-ribbon",
  "label": "Ribbon",
  "layout": "ribbon",
  "count": 7,
  "interval": 2200,
  "css": "#dyn-mosaic-theme[data-theme=\"mosaic-ribbon\"]{background:radial-gradient(80% 60% at 50% 40%,#3a1524,#1b1b1b 70%)}#dyn-mosaic-theme[data-theme=\"mosaic-ribbon\"]::before{content:\"\";position:absolute;left:-10%;right:-10%;top:38%;height:24%;background:linear-gradient(90deg,#d52265,#e94d87 40%,#fec651);opacity:.9;box-shadow:0 18px 40px rgba(0,0,0,.4)}#dyn-mosaic-theme[data-theme=\"mosaic-ribbon\"] .dyn-card{border-radius:10px;box-shadow:0 16px 36px rgba(0,0,0,.45);outline:4px solid #fff}#dyn-mosaic-theme[data-theme=\"mosaic-ribbon\"] .dyn-card:nth-child(odd){transform:translateY(-18px) rotate(-3deg)}#dyn-mosaic-theme[data-theme=\"mosaic-ribbon\"] .dyn-card:nth-child(even){transform:translateY(18px) rotate(3deg)}"
}
