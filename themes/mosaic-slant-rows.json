{"format":"dynamic-backgrounds-theme","version":1,"kind":"mosaic","id":"mosaic-slant-rows","label":"Slant Rows","engine":"mosaic-slant-rows-engine","engineFile":"mosaic-slant-rows-engine.js","interval":7000,"count":9,"settings":{"scale":{"label":"Photo size","default":1},"primary":{"label":"Accent","default":"#e31b23"},"secondary":{"label":"Accent 2","default":"#f36c1b"},"background":{"label":"Background","default":"#141414"}},"css":"#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"]{\n  overflow:hidden;\n  background:var(--background,#141414);\n  --sr-texture:url(\"data:image/webp;base64,\");\n  container-type:size;\n}\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-chrome{\n  position:absolute;z-index:6;width:min(11.5%,132px);aspect-ratio:1;pointer-events:none;\n}\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-logo{top:3.4%;left:3.2%;}\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-qr{bottom:3.4%;right:3.2%;}\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-chrome img,\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-chrome canvas,\n#dyn-mosaic-theme[data-theme=\"mosaic-slant-rows\"] .sr-chrome svg{\n  width:100%;height:100%;object-fit:contain;display:block;\n}\n#dyn-mosaic-theme.dyn-portrait[data-theme=\"mosaic-slant-rows\"] .sr-chrome{\n  width:min(18%,120px);\n}"}